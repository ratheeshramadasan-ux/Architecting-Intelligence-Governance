  "mobilise": {
    "entryCriteria": [
      "A documented business need or enterprise AI ambition exists.",
      "An executive sponsor is willing to own the transformation mandate.",
      "The organisation can identify an initial programme lead and core decision-makers."
    ],
    "outcomes": [
      "A clear mandate and bounded transformation scope.",
      "Named sponsors, accountable owners, forums and decision rights.",
      "Approved principles, risk appetite, funding approach and success measures.",
      "A controlled transition into enterprise discovery."
    ],
    "questions": [
      "Why is enterprise AI important now?",
      "Which outcomes matter, and how will success be measured?",
      "What is in scope, out of scope and explicitly prohibited?",
      "Who owns business outcomes, risk decisions, funding and delivery?",
      "Which evidence must exist before discovery begins?"
    ],
